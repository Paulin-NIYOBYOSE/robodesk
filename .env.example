# Copy to .env and adjust. docker compose reads .env automatically;
# every value below has a development default, so .env is optional locally.

# PostgreSQL credentials used by the postgres container and the API.
POSTGRES_USER=robodesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=robodesk

# Secret used to sign JWT access tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start with a weak secret when ENVIRONMENT=production.
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# development | production
ENVIRONMENT=development

# Comma-separated list of origins allowed to call the API directly.
# Not needed when the frontend is served through the bundled nginx proxy.
CORS_ORIGINS=

# Import seed/episodes.csv on startup (idempotent).
SEED_EPISODES=true

# Host ports
FRONTEND_PORT=3000
API_PORT=8000
